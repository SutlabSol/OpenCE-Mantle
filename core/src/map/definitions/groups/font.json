        "comment": "only used in the jp/kr/tw xbox versions"
      },
      {
        "kind": "field",
        "name": "cjk character codes",
        "type": "uint16",
        "cacheOnly": true,
        "comment": "only set if encoding type is cjk. equal to 256 + the number of font characters with a character > 256"
      },
