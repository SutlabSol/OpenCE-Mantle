      },
      {
        "kind": "field",
        "name": "leading width",
        "type": "int16",
        "cacheOnly": true,
        "comment": "you can't actually set this; it gets overridden with (ascending height + descending height) / 5 on map build"
      },
      {
        "kind": "field",
        "name": "encoding type",
        "type": "FontEncodingType",
