{
  "name": "opence-core",
  "version": "0.1.0",
  "private": true,
  "description": "Pure TypeScript library for parsing and rebuilding Halo: Custom Edition (PC) .map files. No Electron/React/DOM dependencies.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect-map": "tsx scripts/inspect-map.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@mongodb-js/zstd": "^7.0.0"
  }
}
